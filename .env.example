# ---------------------------------------------------------------------------
# Example environment configuration for the origo backend.
#
# Copy this file to `.env` (in the repo root) and adjust the values.
# origo/settings.py loads it automatically via python-dotenv. Variables
# already set in the real environment (systemd unit, container config,
# hosting dashboard) always take precedence over the file.
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------

# Keep this secret in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Never leave this on in production.
DEBUG=False

# PostgreSQL connection string. Leave unset to use the local SQLite fallback.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Domains ------------------------------------------------------------
#
# This is the only thing you normally need to touch to bring a new domain
# online. Everything below (ALLOWED_HOSTS, CORS, CSRF) is derived from it.
#
# Comma-separated list of root domains this deployment serves. For each
# domain the API is expected at <API_SUBDOMAIN>.<domain> and a frontend at
# <sub>.<domain> for every entry in FRONTEND_SUBDOMAINS.
# Use the punycode (xn--...) form for internationalised domains.
DOMAINS=origo.test,xn--fvitsko-exa.se

# The subdomain the Next.js frontends are served from on each domain.
FRONTEND_SUBDOMAINS=flux,verso

# The subdomain the API itself is served from on each domain.
API_SUBDOMAIN=origo.api

# Ports the frontends run on in local dev (used only for CSRF_TRUSTED_ORIGINS).
FRONTEND_DEV_PORTS=3000

# The session/CSRF cookies can only be scoped to one root domain. Defaults
# to the first entry in DOMAINS; set this if the primary domain isn't first.
# ROOT_DOMAIN=xn--fvitsko-exa.se

CACHE_URL=redis://
# --- SLU Artdatabanken APIs (tempus app) -------------------------------
#
# Per-product subscription keys from https://api-portal.artdatabanken.se/ .
# Leave a key unset to disable that product; tempus.services.artdatabanken
# raises ArtdatabankenConfigurationError if it is called without one.
# ARTDATABANKEN_SUBSCRIPTION_KEY_SOS=
# ARTDATABANKEN_SUBSCRIPTION_KEY_TAXON=
# ARTDATABANKEN_SUBSCRIPTION_KEY_SPECIES_INFORMATION=
#
# Base URLs and timeout default to production; override only if needed.
# ARTDATABANKEN_SPECIES_OBSERVATION_URL=https://api.artdatabanken.se/species-observation-system/v1
# ARTDATABANKEN_TAXON_SERVICE_URL=https://api.artdatabanken.se/taxonservice/v1
# ARTDATABANKEN_SPECIES_INFORMATION_URL=https://api.artdatabanken.se/information/v1
# ARTDATABANKEN_TIMEOUT=30
# Larger timeout for paginated SOS observation searches used by phenograms.
# ARTDATABANKEN_PHENOGRAM_TIMEOUT=60
# Minimum quiet period between all Dyntaxa, Artfakta and SOS requests. The
# default is 1 second and is shared by every process on the same machine.
# ARTDATABANKEN_COOLDOWN_SECONDS=1
# Optional shared state-file path; normally the operating-system temp path is fine.
# ARTDATABANKEN_COOLDOWN_STATE_FILE=


# --- Lantmäteriet Marktäcke Direkt (tempus locales) --------------------
#
# Request access to Marktäcke Direkt in Geotorget. The service uses OGC API
# Features for a point lookup; it does not use the STAC GeoPackage download
# endpoint. The integration discovers the accessible collections automatically.
# Optionally restrict it to specific collection IDs, comma-separated.
# LANTMATERIET_MARKTACKE_COLLECTION_IDS=
#
# Private Geotorget customers use Basic authentication with their Geotorget
# credentials - confirmed sufficient on its own by Lantmäteriet's own
# documentation, not just a fallback. Do not commit these values or share
# them in chat.
# LANTMATERIET_MARKTACKE_USERNAME=
# LANTMATERIET_MARKTACKE_PASSWORD=
#
# Or a manually obtained API Portal access token, if you have one.
# LANTMATERIET_MARKTACKE_ACCESS_TOKEN=
# LANTMATERIET_MARKTACKE_TIMEOUT=15
# Map geometries are cached briefly and fetched in pages. The maximum protects
# the API from accidentally serving a country-sized Locale in one response.
# LANTMATERIET_MARKTACKE_MAP_CACHE_SECONDS=300
# LANTMATERIET_MARKTACKE_MAP_PAGE_SIZE=1000
# LANTMATERIET_MARKTACKE_MAP_MAX_FEATURES=10000

# --- Lantmäteriet Kommun, Län och Rike Direkt --------------------------
# Requires the OAPIF product authorization. It reuses the Marktäcke
# Basic-auth credentials above. Collections are discovered automatically.
# LANTMATERIET_ADMINISTRATIVE_BOUNDARIES_BASE_URL=https://api.lantmateriet.se/ogc-features/v1/administrativ-indelning
# LANTMATERIET_ADMINISTRATIVE_BOUNDARIES_COLLECTION_IDS=
# LANTMATERIET_ADMINISTRATIVE_BOUNDARIES_TIMEOUT=15
# LANTMATERIET_ADMINISTRATIVE_BOUNDARIES_MAP_CACHE_SECONDS=300
# LANTMATERIET_ADMINISTRATIVE_BOUNDARIES_MAP_PAGE_SIZE=1000
# LANTMATERIET_ADMINISTRATIVE_BOUNDARIES_MAP_MAX_FEATURES=10000

# --- Lantmäteriet Hydrografi --------------------------------------------
# Lakes, watercourses, and the land-water boundary/coastline. A separate
# product from Marktäcke; sea surface itself is not a collection here (it
# comes from Marktäcke's "markytor" "Hav" objekttyp instead). Reuses the
# Marktäcke Basic-auth credentials above.
# LANTMATERIET_HYDROGRAFI_BASE_URL=https://api.lantmateriet.se/ogc-features/v1/hydrografi
# LANTMATERIET_HYDROGRAFI_COLLECTION_IDS=
# LANTMATERIET_HYDROGRAFI_TIMEOUT=15
# LANTMATERIET_HYDROGRAFI_MAP_CACHE_SECONDS=300
# LANTMATERIET_HYDROGRAFI_MAP_PAGE_SIZE=1000
# LANTMATERIET_HYDROGRAFI_MAP_MAX_FEATURES=10000

# --- Lantmäteriet Ortnamn Direkt (place names) --------------------------
# A separate REST API from the OGC API Features products above (own base
# path, own product authorization in Geotorget - confirm it is granted
# before enabling). Falls back to the Marktäcke Basic-auth credentials
# above unless its own are set below; verify live whether this product
# needs its own API Portal subscription/key instead.
# Use v2.2 (current). If your .env still sets this to v2.1, remove or update it:
# v2.1 is outgoing and answers 401 to accounts authorized for the current version.
# LANTMATERIET_ORTNAMN_BASE_URL=https://api.lantmateriet.se/distribution/produkter/ortnamn/v2.2
# LANTMATERIET_ORTNAMN_USERNAME=
# LANTMATERIET_ORTNAMN_PASSWORD=
# LANTMATERIET_ORTNAMN_ACCESS_TOKEN=
# LANTMATERIET_ORTNAMN_TIMEOUT=15
# LANTMATERIET_ORTNAMN_CACHE_SECONDS=300

# --- OpenStreetMap buildings (Overpass API) -------------------------------
# Building footprints for Locales. No key or account. ODbL data: credit
# "© OpenStreetMap contributors" wherever it is shown. The public instance
# rate limits (HTTP 429 seen after a few quick queries); the client retries.
# Please set a User-Agent that identifies this service.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OVERPASS_USER_AGENT=origo-tempus
# OVERPASS_TIMEOUT=120
# OVERPASS_CACHE_SECONDS=2592000
# OVERPASS_MAX_FEATURES=30000

# --- Lantmäteriet Byggnad Direkt (buildings) - NOT USED -------------------
# Replaced by the OpenStreetMap source above: the product needs a legal review
# before access is granted (HTTP 403 without it). Its client code is still in
# tempus/services/lantmateriet.py but is not registered anywhere.
# A separate REST API from the OGC API Features products above and from
# Ortnamn (own base path, own product authorization in Geotorget - confirm
# it is granted before enabling). Falls back to the Marktäcke Basic-auth
# credentials above unless its own are set below. Per-request area/perimeter
# limits (1,000,000 m² / 200,000 m) are tiled around client-side; only
# increase MAX_AREA_SQM/MAX_PERIMETER_M if Lantmäteriet's own documented
# limits change - these are not arbitrary tuning knobs.
# LANTMATERIET_BYGGNAD_BASE_URL=https://api.lantmateriet.se/distribution/produkter/byggnad/v3
# LANTMATERIET_BYGGNAD_USERNAME=
# LANTMATERIET_BYGGNAD_PASSWORD=
# LANTMATERIET_BYGGNAD_ACCESS_TOKEN=
# LANTMATERIET_BYGGNAD_TIMEOUT=15
# LANTMATERIET_BYGGNAD_CACHE_SECONDS=300
# LANTMATERIET_BYGGNAD_MAX_AREA_SQM=1000000
# LANTMATERIET_BYGGNAD_MAX_PERIMETER_M=200000
# LANTMATERIET_BYGGNAD_MAX_TILES=400


# --- Trafikverket API (roads) --------------------------------------------
# NVDB road segments for Locales. A separate provider from Lantmäteriet: one
# XML-over-POST endpoint where the key travels in the request body. Roads are
# clipped to the Locale and prefetched with the other layers.
# TRAFIKVERKET_TOKEN=
# TRAFIKVERKET_URL=https://api.trafikinfo.trafikverket.se/v2/data.json
# TRAFIKVERKET_TIMEOUT=30
# TRAFIKVERKET_CACHE_SECONDS=2592000
# Rows per request and the safety cap on segments per area (the fetch fails
# rather than returning a partial layer when exceeded).
# TRAFIKVERKET_PAGE_SIZE=1000
# TRAFIKVERKET_MAX_FEATURES=20000

# --- Tempus visual map base ---------------------------------------------
# Public OpenFreeMap vector-tile style. No account or key is required.
# TEMPUS_MAP_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty


# --- Background tasks (tempus phenograms) ------------------------------
#
# Phenogram generation runs via django-tasks. Default backend is the
# database queue (django-tasks-db), which needs a worker process:
#   python manage.py db_worker
# On a host with no worker (or in local dev) run tasks inline instead:
# TASKS_BACKEND=django_tasks.backends.immediate.ImmediateBackend

# --- Apsis weekly newsletter -------------------------------------------
#
# APSIS_NEWSLETTER_TIME_ZONE=Europe/Stockholm


# --- Manual overrides (optional) ----------------------------------------
#
# If set, each of these completely replaces the value derived from DOMAINS.
# Comma-separated.
# ALLOWED_HOSTS=localhost,127.0.0.1,.example.com
# CORS_ALLOWED_ORIGINS=https://flux.example.com,https://verso.example.com
# CSRF_TRUSTED_ORIGINS=https://origo.api.example.com,https://flux.example.com



# -------------------- Apsis connections --------------
# Apsis supports connecting an apsis to a Swedish cherch building. 
#SVENSKAKYRKAN_TOKEN=