# ---------------------------------------------------------------------------
# Example environment configuration for the origo backend.
#
# Copy this file to `.env` (in the repo root) and adjust the values.
# origo/settings.py loads it automatically via python-dotenv. Variables
# already set in the real environment (systemd unit, container config,
# hosting dashboard) always take precedence over the file.
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------

# Keep this secret in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Never leave this on in production.
DEBUG=False

# PostgreSQL connection string. Leave unset to use the local SQLite fallback.
# DATABASE_URL=postgres://user:password@host:5432/dbname


# --- Domains ------------------------------------------------------------
#
# This is the only thing you normally need to touch to bring a new domain
# online. Everything below (ALLOWED_HOSTS, CORS, CSRF) is derived from it.
#
# Comma-separated list of root domains this deployment serves. For each
# domain the API is expected at <API_SUBDOMAIN>.<domain> and a frontend at
# <sub>.<domain> for every entry in FRONTEND_SUBDOMAINS.
# Use the punycode (xn--...) form for internationalised domains.
DOMAINS=origo.test,xn--fvitsko-exa.se

# The subdomain the Next.js frontends are served from on each domain.
FRONTEND_SUBDOMAINS=flux,verso

# The subdomain the API itself is served from on each domain.
API_SUBDOMAIN=origo.api

# Ports the frontends run on in local dev (used only for CSRF_TRUSTED_ORIGINS).
FRONTEND_DEV_PORTS=3000

# The session/CSRF cookies can only be scoped to one root domain. Defaults
# to the first entry in DOMAINS; set this if the primary domain isn't first.
# ROOT_DOMAIN=xn--fvitsko-exa.se


# --- SLU Artdatabanken APIs (tempus app) -------------------------------
#
# Per-product subscription keys from https://api-portal.artdatabanken.se/ .
# Leave a key unset to disable that product; tempus.services.artdatabanken
# raises ArtdatabankenConfigurationError if it is called without one.
# ARTDATABANKEN_SUBSCRIPTION_KEY_SOS=
# ARTDATABANKEN_SUBSCRIPTION_KEY_TAXON=
# ARTDATABANKEN_SUBSCRIPTION_KEY_SPECIES_INFORMATION=
#
# Base URLs and timeout default to production; override only if needed.
# ARTDATABANKEN_SPECIES_OBSERVATION_URL=https://api.artdatabanken.se/species-observation-system/v1
# ARTDATABANKEN_TAXON_SERVICE_URL=https://api.artdatabanken.se/taxonservice/v1
# ARTDATABANKEN_SPECIES_INFORMATION_URL=https://api.artdatabanken.se/information/v1
# ARTDATABANKEN_TIMEOUT=30
# Larger timeout for paginated SOS observation searches used by phenograms.
# ARTDATABANKEN_PHENOGRAM_TIMEOUT=60
# Minimum quiet period between all Dyntaxa, Artfakta and SOS requests. The
# default is 1 second and is shared by every process on the same machine.
# ARTDATABANKEN_COOLDOWN_SECONDS=1
# Optional shared state-file path; normally the operating-system temp path is fine.
# ARTDATABANKEN_COOLDOWN_STATE_FILE=


# --- Background tasks (tempus phenograms) ------------------------------
#
# Phenogram generation runs via django-tasks. Default backend is the
# database queue (django-tasks-db), which needs a worker process:
#   python manage.py db_worker
# On a host with no worker (or in local dev) run tasks inline instead:
# TASKS_BACKEND=django_tasks.backends.immediate.ImmediateBackend


# --- Manual overrides (optional) ----------------------------------------
#
# If set, each of these completely replaces the value derived from DOMAINS.
# Comma-separated.
# ALLOWED_HOSTS=localhost,127.0.0.1,.example.com
# CORS_ALLOWED_ORIGINS=https://flux.example.com,https://verso.example.com
# CSRF_TRUSTED_ORIGINS=https://origo.api.example.com,https://flux.example.com
